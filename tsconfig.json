{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "declaration": true,
    "types": ["node", "react", "react-dom", "mocha", "chai"]
  },
  "include": ["src/**/*", "contracts/**/*", "test/**/*", "hardhat.config.ts", "typechain-types/**/*"],
  "exclude": ["node_modules", "dist", "dist-ui"]
}
